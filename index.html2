
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LAPTOPVERSE - Find Your Perfect Laptop</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #080713;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 7%;
  border-bottom: 1px solid #302747;
  position: sticky;
  top: 0;
  background: #080713;
  z-index: 10;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #a78bfa;
  letter-spacing: 2px;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 15px;
  font-size: 13px;
}

.hero {
  min-height: 570px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 50px 20px;
  background:
  radial-gradient(ellipse at center,
  #38216b 0%, #15102e 45%, #080713 80%);
}

.tag {
  color: #c4b5fd;
  border: 1px solid #8057d5;
  padding: 10px 18px;
  border-radius: 30px;
  margin-bottom: 25px;
  font-size: 12px;
}

.hero h1 {
  font-size: clamp(40px, 8vw, 75px);
  max-width: 850px;
  line-height: 1.1;
}

.hero h1 span {
  color: #a78bfa;
}

.hero p {
  color: #b8b3ca;
  margin: 22px 0;
  line-height: 1.7;
}

.laptop-art {
  font-size: 110px;
  margin: 20px;
  filter: drop-shadow(0 0 35px #8057d5);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

.search {
  display: flex;
  width: min(550px, 95%);
  background: #19152a;
  border: 1px solid #8057d5;
  border-radius: 12px;
  padding: 7px;
}

.search input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  color: white;
  padding: 12px;
}

button {
  background: #8254e8;
  border: none;
  color: white;
  padding: 13px 20px;
  border-radius: 8px;
  cursor: pointer;
}

.section {
  padding: 65px 7%;
}

.section h2 {
  font-size: 30px;
  margin-bottom: 12px;
}

.subtitle {
  color: #aaa3bf;
  margin-bottom: 30px;
}

.grid {
  display: grid;
  grid-template-columns:
  repeat(auto-fit, minmax(145px, 1fr));
  gap: 18px;
}

.card {
  background: #141123;
  border: 1px solid #302747;
  border-radius: 15px;
  padding: 25px 18px;
  transition: 0.3s;
  cursor: pointer;
}

.card:hover {
  transform: translateY(-6px);
  border-color: #986cff;
  background: #201936;
}

.card h3 {
  color: #c4b5fd;
  margin-bottom: 10px;
}

.card p {
  color: #aaa3bf;
  font-size: 14px;
  line-height: 1.5;
}

.budget-box {
  background: linear-gradient(120deg,#241541,#111025);
  padding: 30px;
  border: 1px solid #6544a6;
  border-radius: 18px;
}

.budget-box input {
  width: 100%;
  padding: 14px;
  margin: 20px 0;
  background: #080713;
  border: 1px solid #6544a6;
  border-radius: 8px;
  color: white;
  font-size: 17px;
}

.result {
  margin-top: 18px;
  color: #c4b5fd;
  line-height: 1.6;
}

footer {
  text-align: center;
  padding: 35px;
  color: #8e87a6;
  border-top: 1px solid #29233e;
}

@media(max-width:600px) {
  header { padding: 18px 12px; }
  .logo { font-size: 18px; }
  nav a { margin-left: 7px; font-size: 11px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">LAPTOPVERSE</div>
  <nav>
    <a href="#categories">Explore</a>
    <a href="#brands">Brands</a>
    <a href="#budget">Budget</a>
  </nav>
</header>

<section class="hero">

  <div class="tag">THE FUTURE OF LAPTOP DISCOVERY</div>

  <h1>
    Find Your <span>Perfect Laptop.</span>
  </h1>

  <p>
    Explore thousands of possibilities.
    Compare smarter. Buy better.
  </p>

  <div class="laptop-art">💻</div>

  <div class="search">
    <input id="searchInput"
    placeholder="Search laptop, brand or processor...">
    <button onclick="searchLaptop()">Search</button>
  </div>

</section>

<section class="section" id="categories">

  <h2>Explore Categories</h2>
  <p class="subtitle">Find the perfect laptop for your needs.</p>

  <div class="grid">
    <div class="card"><h3>🎓 Student</h3><p>Learning and everyday tasks.</p></div>
    <div class="card"><h3>⌨️ Coding</h3><p>Programming and development.</p></div>
    <div class="card"><h3>🎮 Gaming</h3><p>Gaming and performance.</p></div>
    <div class="card"><h3>🎨 Creator</h3><p>Editing and designing.</p></div>
    <div class="card"><h3>💼 Business</h3><p>Professional productivity.</p></div>
    <div class="card"><h3>⚡ All Rounder</h3><p>Balanced performance.</p></div>
  </div>

</section>

<section class="section" id="brands">

  <h2>Explore Top Brands</h2>
  <p class="subtitle">Discover laptop manufacturers.</p>

  <div class="grid">
    <div class="card"><h3>HP</h3><p>Computers and technology</p></div>
    <div class="card"><h3>Dell</h3><p>Business and personal PCs</p></div>
    <div class="card"><h3>Lenovo</h3><p>Personal computing</p></div>
    <div class="card"><h3>ASUS</h3><p>Computers and hardware</p></div>
    <div class="card"><h3>Acer</h3><p>Computing devices</p></div>
    <div class="card"><h3>Apple</h3><p>Mac computers</p></div>
    <div class="card"><h3>MSI</h3><p>Gaming and creator PCs</p></div>
    <div class="card"><h3>Samsung</h3><p>Galaxy Book laptops</p></div>
  </div>

</section>

<section class="section" id="budget">

  <div class="budget-box">
    <h2>Find Laptops By Budget</h2>
    <p class="subtitle">Enter your maximum budget in rupees.</p>

    <input type="number" id="budgetInput"
    placeholder="Example: 20000">

    <button onclick="findBudget()">Explore My Budget</button>

    <div class="result" id="budgetResult"></div>
  </div>

</section>

<footer>
  © 2026 LAPTOPVERSE
  <p style="margin-top:10px">Discover. Compare. Choose Smarter.</p>
</footer>

<script>

function searchLaptop() {
  let query = document.getElementById("searchInput").value.trim();

  if (!query) {
    alert("Please enter a laptop or brand!");
    return;
  }

  alert("You searched for: " + query +
  "\nOur laptop database is coming soon!");
}

function findBudget() {
  let budget = Number(document.getElementById("budgetInput").value);

  let result = document.getElementById("budgetResult");

  if (!budget || budget <= 0) {
    result.innerHTML = "Please enter a valid budget.";
    return;
  }

  result.innerHTML =
  "Your maximum budget is ₹" +
  budget.toLocaleString("en-IN") +
  ". Our smart laptop finder will help you discover suitable laptops!";
}

</script>

</body>
</html>
